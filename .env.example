# ==============================================================================
# Smart College Admission Counselor Agent - Environment Template (.env.example)
# ==============================================================================
# Copy to backend/.env and frontend/.env respectively.
# NEVER commit your production .env files or database credentials to git.

# ── Backend Configuration (backend/.env) ──────────────────────────────────────
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://smart-college-counselor.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://smart-college-counselor.vercel.app

# MySQL Database (Local or Managed Cloud)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=smart_counsel
DB_DIALECT=mysql
DB_SSL=false

# Optional unified connection string:
# DATABASE_URL=mysql://root:password@host:port/smart_counsel

# Google Gemini API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Frontend Configuration (frontend/.env) ─────────────────────────────────────
# Point to your production backend API:
# VITE_API_URL=https://smart-counsel-api.onrender.com/api
