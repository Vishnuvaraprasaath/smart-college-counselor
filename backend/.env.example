# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_counsel
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Google Gemini AI (optional — app works without it using fallback engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Server
PORT=5000
