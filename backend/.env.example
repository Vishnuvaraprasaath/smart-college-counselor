# ==============================================================================
# Smart College Admission Counselor - Backend Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and provide your actual values.
# NEVER commit your real .env file or database passwords to git.

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Frontend & CORS Configuration ─────────────────────────────────────────────
# Set to your production frontend domain (e.g. deployed on Vercel)
FRONTEND_URL=https://smart-college-counselor.vercel.app

# Optional comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://smart-college-counselor.vercel.app

# ── MySQL Database Configuration (Local or Managed Cloud) ─────────────────────
# Option A: Discrete Connection Parameters (Standard)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=smart_counsel
DB_DIALECT=mysql
DB_SSL=false

# Option B: Unified Connection String (Managed MySQL / Railway / PlanetScale / Aiven)
# DATABASE_URL=mysql://root:password@host:port/smart_counsel

# ── Google Gemini AI API Key (Optional) ───────────────────────────────────────
# Enables live AI counseling in CounselChat; fallback heuristics operate if empty
GEMINI_API_KEY=your_gemini_api_key_here
