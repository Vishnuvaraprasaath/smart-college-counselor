# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# ── Local Development ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_counsel
DB_USER=root
DB_PASS=your_mysql_password_here
DB_SSL=false

# ── Railway Deployment (replace with values from Railway dashboard) ─
# DB_HOST=containers-us-west-xx.railway.app
# DB_PORT=6543
# DB_NAME=railway
# DB_USER=root
# DB_PASS=your_railway_password
# DB_SSL=true

# Google Gemini AI (optional — app works without it using fallback engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=5000
